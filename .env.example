# Developer template only. Runtime code and Compose use the ignored root .env,
# never this file directly. Copy it to .env when setting up a new checkout.
# The example password is local-only; use a secret value outside development.
POSTGRES_DB=intertext
POSTGRES_USER=intertext
POSTGRES_PASSWORD=intertext
POSTGRES_PORT=5432

# Host ports. Browser requests go to FRONTEND_PORT; /api is proxied internally.
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Host-run backend and ingestion commands connect through the published DB port.
DATABASE_URL=postgresql+psycopg://intertext:intertext@localhost:5432/intertext

# The backend container reaches PostgreSQL by Compose service name.
DATABASE_URL_DOCKER=postgresql+psycopg://intertext:intertext@db:5432/intertext

# development (reload/watch) or production (small runtime images).
INTERTEXT_BUILD_TARGET=development
